[Unit]
Description=Palantir harvester - weekly trigger (Sunday 00:05 Paris)

[Timer]
# The index expires on the Saturday-to-Sunday night; harvest right after,
# at a quiet hour with no deploy waves around. The harvester machine runs
# on the London timezone, which tracks Paris DST on the same dates, so
# Saturday 23:05 local is always Sunday 00:05 Paris. Persistent replays a
# missed run after a reboot.
OnCalendar=Sat *-*-* 23:05:00
Persistent=true

[Install]
WantedBy=timers.target
