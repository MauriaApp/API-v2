# Palantir harvester: builds the weekly planning index and publishes it to
# mauria-api. Installed on the harvester machine (see scripts/palantir-daemon.ts).
#
#   sudo cp scripts/palantir-harvest.service /etc/systemd/system/
#   sudo cp scripts/palantir-harvest.timer  /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now palantir-harvest.timer

[Unit]
Description=Palantir harvester - weekly Junia planning index
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=louis
WorkingDirectory=/home/louis/Programming/palantir
EnvironmentFile=/home/louis/.config/palantir/harvest.env
# The harvest must never run on the machine's own IP: a Junia ban would hit
# it instead of the API, but the "+" runs these as root regardless of User=,
# and a failed ExecStartPre aborts the whole service before any Aurion call.
ExecStartPre=+/usr/bin/wg-quick up protonvpn-wg
ExecStart=/home/louis/.nvm/versions/node/v22.19.0/bin/node node_modules/ts-node/dist/bin.js -T scripts/palantir-daemon.ts
ExecStopPost=+/usr/bin/wg-quick down protonvpn-wg
# Harvest (~15 min) plus publish retries (up to 3 h by default).
TimeoutStartSec=4h
